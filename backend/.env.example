SUPABASE_URL="your_supabase_url_here"
SUPABASE_KEY="your_supabase_key_here"

# Allowed origins for CORS (JSON array or comma-separated string)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "https://cyber-shadow-eight.vercel.app"]'

# Gemini configuration (backend-only, never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
# LLM_API_KEY is also accepted as a backwards-compatible alias for GEMINI_API_KEY
LLM_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest